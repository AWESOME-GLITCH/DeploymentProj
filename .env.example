# Copy to .env.local and fill in to enable live AI agents.
# Without this key the app runs in DEMO MODE (returns crafted sample output) so
# it still deploys and demos cleanly.
ANTHROPIC_API_KEY=

# Optional: override the model used by the agents.
PM_AGENT_MODEL=claude-sonnet-5

# ElevenLabs voice for the Learning Path prototype (tap-to-hear, lesson lines,
# stories). Without a key the app uses the browser voice.
ELEVENLABS_API_KEY=
# Optional: a voice id from your ElevenLabs library (default: Lily, British English)
ELEVENLABS_VOICE_ID=
# Optional: model id (default eleven_turbo_v2_5)
ELEVENLABS_MODEL_ID=
